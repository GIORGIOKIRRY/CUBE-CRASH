; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[admob]

general/android/app_id="ca-app-pub-7508049500048357~8460723725"
general/ios/app_id="ca-app-pub-7508049500048357~9549875894"

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="CubeCrash"
config/version="0.0.9"
run/main_scene="uid://c0cubecrashload1"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.03, 0.09, 0.24, 1)
boot_splash/image="res://CORE/Assets/Art/Loading/loading_bg.png"
config/icon="uid://o7mxndnfjij4"
boot_splash/stretch_mode=0

[autoload]

loc="*res://loc.gd"
settings="*res://settings.gd"
transition="*res://transition.gd"
missions="*res://missions.gd"
ads="*res://ads.gd"
leaderboard="*res://leaderboard.gd"

[display]

window/size/viewport_width=576
window/size/viewport_height=1024
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/admob/plugin.cfg")

[file_customization]

folder_colors={
"res://CORE/": "red",
"res://CORE/Assets/": "yellow",
"res://CORE/Assets/Art/": "green",
"res://CORE/Assets/Art/FX/": "teal",
"res://CORE/Assets/Art/Game/": "pink",
"res://CORE/Assets/Art/UI/": "orange",
"res://CORE/Scene/": "blue",
"res://CORE/Scene/PieceScene/": "orange",
"res://CORE/Script/": "purple"
}

[gui]

theme/custom_font="uid://gq80lnfikflh"

[input]

ui_touch={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"button_mask":0,"position":Vector2(0, 0),"global_position":Vector2(0, 0),"factor":1.0,"button_index":1,"canceled":false,"pressed":false,"double_click":false,"script":null)
]
}

[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/translations=PackedStringArray("res://addons/admob/gdscript/sample/translations/admob_sample.en.translation", "res://addons/admob/gdscript/sample/translations/admob_sample.pt_BR.translation", "res://addons/admob/gdscript/sample/translations/admob_sample.es.translation", "res://addons/admob/gdscript/sample/translations/admob_sample.zh_CN.translation", "res://addons/admob/gdscript/sample/translations/admob_sample.ja.translation")

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.03, 0.09, 0.24, 1)
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
